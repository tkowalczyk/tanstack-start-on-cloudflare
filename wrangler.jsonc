{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/server.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/worker/*",
      "/_server/*",
      "!/assets/*",
      "!/*.js",
      "!/*.css",
      "!/*.woff2",
      "!/*.png",
      "!/*.jpg",
      "!/*.svg",
      "!/*.ico"
    ]
  },
  "vars": {
    "MY_VAR": "Hello from Cloudflare",
  },
  "env": {
    "stage": {
      "name": "tanstack-start-app-stage",
      "routes": [
        {
          "custom_domain": true,
          "pattern": "stage.tkow.net"
        }
      ],
      "vars": {
        "MY_VAR": "Hello from Cloudflare Stage",
      },
    },
    "prod": {
      "name": "tanstack-start-app-prod",
      "routes": [
        {
          "custom_domain": true,
          "pattern": "tkow.net"
        }
      ],
      "vars": {
        "MY_VAR": "Hello from Cloudflare Prod",
      },
    },
  },
}